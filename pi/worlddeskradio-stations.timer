# Refreshes the station list once a month, in the small hours. If the radio was off then, it
# runs soon after it's next on (Persistent). A refresh cut short carries on from where it stopped.

[Unit]
Description=World Desk Radio: refresh the station list monthly

[Timer]
OnCalendar=*-*-01 03:30
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target

# The monthly station-list refresh (started by terradio-stations.timer). It downloads a fresh
# list beside the one in use and swaps it in only when it's complete; the running radio notices
# and starts again on it the next time nobody's listening, which also sends the face its new dots.
#
#   systemctl --user start terradio-stations     refresh now
#   journalctl --user-unit terradio-stations       how the last one went

[Unit]
Description=Terradio: refresh the station list

[Service]
Type=oneshot
WorkingDirectory=%h/terradio
ExecStart=%h/terradio/.venv/bin/python %h/terradio/radio.py --refresh-stations
Environment=PYTHONUNBUFFERED=1
# Gently: the radio may be playing while it downloads.
Nice=10
IOSchedulingClass=idle
